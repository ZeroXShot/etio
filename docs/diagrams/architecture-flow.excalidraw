      "seed": 1365102471,
      "version": 2,
      "versionNonce": 1292356647,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790807604279,
      "link": null,
      "locked": false,
      "text": "OTLP over gRPC :4317 (tonic) and\nHTTP :4318 (axum): protobuf or\nJSON, gzip or zstd, decoded on\nthe async runtime's threads\n\n- bearer tokens, compared\n  in constant time\n- request and decompression limits\n- selective zero-copy decoding:\n  ~4x faster than prost,\n  differential-tested against it",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "OTLP over gRPC :4317 (tonic) and\nHTTP :4318 (axum): protobuf or\nJSON, gzip or zstd, decoded on\nthe async runtime's threads\n\n- bearer tokens, compared\n  in constant time\n- request and decompression limits\n- selective zero-copy decoding:\n  ~4x faster than prost,\n  differential-tested against it",
      "autoResize": true,
      "lineHeight": 1.25
    },
