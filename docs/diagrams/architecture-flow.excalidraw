      "boundElements": null,
      "updated": 1790807604279,
      "link": null,
      "locked": false,
      "text": "30 s after opening, then\nevery 60 s: reference (20 min)\nvs abnormal period; robust\nseries scores -> 20 scale-free\nfeatures + graph random walk\n-> linear listwise model with\na heuristic prior, ensembled\nwith the heuristic model\n-> probabilities, exact\ncontributions, reasons",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "30 s after opening, then\nevery 60 s: reference (20 min)\nvs abnormal period; robust\nseries scores -> 20 scale-free\nfeatures + graph random walk\n-> linear listwise model with\na heuristic prior, ensembled\nwith the heuristic model\n-> probabilities, exact\ncontributions, reasons",
      "autoResize": true,
      "lineHeight": 1.25
    },
