      "boundElements": null,
      "updated": 1790807604279,
      "link": null,
      "locked": false,
      "text": "a service is anomalous after\n3 confirmed windows; opens\nwhen >= 2 services are, one\nseverely (surprise >= 8), or\nan entry point's latency,\nerrors or traffic; resolves\nafter 180 s of quiet;\nIDs derive from the data",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
